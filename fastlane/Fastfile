default_platform(:mac)

# Uploads the Mac App Store package electron-builder produced. Signing and
# packaging happen in scripts/build-mas.ts; this lane only talks to App Store
# Connect, with the same API-key secrets the mobile repository uses.
platform :mac do
  desc "Upload the tagged Mac App Store build and submit it for review"
  lane :app_store_release do
    # electron-builder writes the mas package next to the app (release/mas-arm64/).
    pkg = Dir[File.expand_path("../release/**/*-mas-*.pkg", __dir__)].first
    UI.user_error!("No Mac App Store package in release/ — run `npm run dist:mas` first") unless pkg

    tag = ENV.fetch("GITHUB_REF_NAME", "")
    match = tag.match(/\Av(\d+\.\d+\.\d+)\z/)
    UI.user_error!("Release tags must use vN.N.N format, got #{tag.inspect}") unless match

    # Every update needs "What's New" text. release.yml writes it with
    # `release-notes.ts --store`; deliver leaves it off the first version,
    # where App Store Connect does not accept it.
    notes_path = File.expand_path("../release/mas-release-notes.txt", __dir__)
    notes = File.exist?(notes_path) ? File.read(notes_path).strip : ""
    notes = "- Bug fixes and performance improvements." if notes.empty?
    metadata_dir = File.expand_path("../release/mas-metadata", __dir__)
    FileUtils.rm_rf(metadata_dir)
    FileUtils.mkdir_p(File.join(metadata_dir, "en-US"))
    File.write(File.join(metadata_dir, "en-US", "release_notes.txt"), "#{notes}\n")

    upload_to_app_store(
      api_key: app_store_connect_api_key(
        key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
        issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
        key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
        is_key_content_base64: true,
        duration: 1200
      ),
      platform: "osx",
      app_identifier: "com.digitaltolk.ex.electron",
      pkg: pkg,
      app_version: match[1],
      # The listing (description, screenshots, privacy) is maintained in App
      # Store Connect; a release only ships the binary and its notes, the one
      # file in metadata_dir.
      metadata_path: metadata_dir,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      automatic_release: true,
      force: true,
      submit_for_review: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end
end
