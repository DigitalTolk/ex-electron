{
  "name": "ex-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for the ex team chat.",
  "private": true,
  "main": "dist/main.js",
  "author": "Günter Grodotzki",
  "license": "MIT",
  "scripts": {
    "icons": "tsx scripts/make-icons.ts",
    "bundle": "tsx scripts/bundle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && npm run lint && npm run bundle && npm run icons",
    "start": "npm run bundle && npm run icons && electron .",
    "dist": "npm run build && tsx scripts/build-app.ts",
    "dist:mac": "npm run build && tsx scripts/build-app.ts --mac --arm64",
    "dist:linux": "npm run build && tsx scripts/build-app.ts --linux --x64 --arm64",
    "dist:win": "npm run build && tsx scripts/build-app.ts --win --x64 --arm64",
    "dist:all": "npm run build && tsx scripts/build-app.ts --mac --arm64 --linux --x64 --arm64 --win --x64 --arm64"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.0"
  }
}
